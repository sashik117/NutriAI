DATABASE_URL=postgres://postgres:password@localhost:5432/nutriai
DATABASE_SSL=false
DATABASE_SCHEMA=nutriai
PORT=4001
CORS_ORIGIN=http://localhost:5176

# Auth sessions. Use a long random value in production.
SESSION_SECRET=change_me_to_a_long_random_secret
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=Lax

# Email verification. In development, codes are logged and returned as dev_code
# when SMTP is not configured. In production SMTP is required for registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Gemini is preferred for AI/photo/audio features.
# Without an AI key, the app returns safe fallback data instead of failing.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional fallback if Gemini is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Frontend/mobile API URL. Keep empty for Vite dev proxy in browser.
# For a real phone app, set this to a deployed HTTPS backend URL.
VITE_API_BASE_URL=
